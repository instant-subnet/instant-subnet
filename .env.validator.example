# Localnet validator. Copy to .env.validator on the validator host.
INSTANT_CONFIG_DIR=/opt/instant-subnet/config
INSTANT_NETWORK=local
INSTANT_CHAIN_ENDPOINT=ws://68.183.141.180:80
INSTANT_NETUID=5

INSTANT_WALLET_NAME=validator
INSTANT_WALLET_HOTKEY=REPLACE_WITH_REGISTERED_VALIDATOR_HOTKEY_NAME
INSTANT_WALLET_PATH=/home/instant/.bittensor/wallets

INSTANT_MODEL_TIER=mock
INSTANT_MAX_MODEL_LEN=8192
INSTANT_ATTESTATION_MODE=off

INSTANT_VALIDATOR_HOST=127.0.0.1
INSTANT_VALIDATOR_PORT=8092
INSTANT_STATE_DB=/var/lib/instant-subnet/validator.sqlite3
INSTANT_METAGRAPH_REFRESH_S=30
INSTANT_REQUEST_TIMEOUT_S=10
INSTANT_PLATFORM_URL=https://REPLACE_WITH_PLATFORM_HOST
# The platform wallet hotkey SS58. Validator telemetry is rejected unless the
# exact response bytes are signed by this key and addressed to this validator.
INSTANT_PLATFORM_SS58=REPLACE_WITH_PLATFORM_HOTKEY_SS58
INSTANT_TELEMETRY_MAX_AGE_S=120
INSTANT_TELEMETRY_MAX_WINDOW_S=7200

# Startup and the PM2 loop never write weights. To run an operator-reviewed
# localnet one-shot, first score/inspect, then temporarily set this true and run
# `instant-validator --set-weights-once`; set it false again afterwards.
INSTANT_ENABLE_WEIGHT_WRITES=false
INSTANT_EXPECTED_SPEC_VERSION=393
INSTANT_WEIGHT_MECHANISM_ID=0
INSTANT_WEIGHT_VERSION_KEY=0
INSTANT_WEIGHT_PERIOD_BLOCKS=8

INSTANT_LOG_LEVEL=INFO
