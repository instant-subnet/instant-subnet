# Localnet miner. Copy to .env.miner on the GPU host and replace placeholders.
INSTANT_CONFIG_DIR=/opt/instant-subnet/config
INSTANT_NETWORK=local
INSTANT_CHAIN_ENDPOINT=ws://68.183.141.180:80
INSTANT_NETUID=5

INSTANT_WALLET_NAME=miner
INSTANT_WALLET_HOTKEY=REPLACE_WITH_REGISTERED_MINER_HOTKEY_NAME
INSTANT_WALLET_PATH=/home/instant/.bittensor/wallets

INSTANT_MODEL_TIER=dev1
INSTANT_MAX_MODEL_LEN=8192
INSTANT_ATTESTATION_MODE=off
INSTANT_VLLM_URL=http://127.0.0.1:8000
INSTANT_MAX_CONCURRENT=1

INSTANT_MINER_HOST=0.0.0.0
INSTANT_MINER_PORT=8091
INSTANT_METAGRAPH_REFRESH_S=120

# The signer allowed to send platform traffic to this miner.
INSTANT_PLATFORM_SS58=REPLACE_WITH_PLATFORM_HOTKEY_SS58
INSTANT_PLATFORM_URL=https://REPLACE_WITH_PLATFORM_HOST

INSTANT_LOG_LEVEL=INFO
