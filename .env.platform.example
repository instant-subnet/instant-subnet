# Initial single-miner localnet gateway. Copy to .env.platform on the OCI host.
INSTANT_CONFIG_DIR=/opt/instant-subnet/config
INSTANT_NETWORK=local
INSTANT_CHAIN_ENDPOINT=ws://68.183.141.180:80
INSTANT_NETUID=5

INSTANT_WALLET_NAME=platform
INSTANT_WALLET_HOTKEY=REPLACE_WITH_PLATFORM_HOTKEY_NAME
INSTANT_WALLET_PATH=/home/instant/.bittensor/wallets

INSTANT_MODEL_TIER=mock
INSTANT_MAX_MODEL_LEN=8192
INSTANT_ATTESTATION_MODE=off

# Bind behind nginx. The miner URL must be reachable from this host.
INSTANT_PLATFORM_HOST=127.0.0.1
INSTANT_PLATFORM_PORT=8090
INSTANT_PLATFORM_MINER_URL=http://165.227.197.158:8091
INSTANT_PLATFORM_MINER_SS58=REPLACE_WITH_REGISTERED_MINER_HOTKEY_SS58
INSTANT_PLATFORM_MINER_UID=REPLACE_WITH_MINER_UID
INSTANT_REQUEST_TIMEOUT_S=300

# Store only the digest. Generate a high-entropy isk_... token offline, then run:
# printf %s "$TOKEN" | sha256sum
INSTANT_PLATFORM_API_KEY_SHA256=REPLACE_WITH_64_CHARACTER_SHA256_HEX
INSTANT_PLATFORM_STATE_DB=/opt/instant-subnet/data/platform.sqlite3
INSTANT_PLATFORM_VALIDATOR_SS58=REPLACE_WITH_VALIDATOR_HOTKEY_SS58
INSTANT_PLATFORM_STATS_WINDOW_S=3600

INSTANT_LOG_LEVEL=INFO
