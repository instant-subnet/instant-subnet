# Instant validator — production defaults are Finney and subnet 46.
INSTANT_NETWORK=finney
INSTANT_NETUID=46

# Leave empty to use Bittensor's trusted Finney selection. Set explicitly only
# for a privately configured alternate chain.
INSTANT_CHAIN_ENDPOINT=

INSTANT_WALLET_NAME=validator
INSTANT_WALLET_HOTKEY=default
INSTANT_WALLET_PATH=~/.bittensor/wallets

# Keep true until the exact report-derived vector has passed end-to-end review
# and an operator explicitly approves submitting performance weights.
INSTANT_BURN_MINER_EMISSIONS=true

INSTANT_PLATFORM_REPORT_URL=https://api.instantsubnet.com/validator/v1/reports/latest
INSTANT_PLATFORM_SIGNER=

INSTANT_POLL_INTERVAL_SECONDS=3600
INSTANT_REPORT_MAX_AGE_SECONDS=86400
INSTANT_REPORT_FUTURE_SKEW_SECONDS=60
INSTANT_REQUEST_TIMEOUT_SECONDS=15
INSTANT_STATE_PATH=var/validator-state.json
INSTANT_LOG_LEVEL=INFO

# Keep false until Burn mode is confirmed and commit/reveal is disabled.
INSTANT_ENABLE_WEIGHT_WRITES=false
